# =================================================
# 3. verifier les valeurs aberrantes
# =================================================

"""Vérifier prix nuls ou négatifs"""
class DonneeInvalide(ValueError):
    """Exeception personalisée de ValueError"""

# colonnes à vérifier
colonnes_a_verifier = [
    "price", 
    "bedrooms", 
    "bathrooms", 
    "sqft_living", 
    "sqft_lot", 
    "floors",
    "waterfront",
    "view",
    "condition",
    "sqft_above",
    "sqft_basement",
    "yr_built",
    "yr_renovated"
]
for colonne in colonnes_a_verifier:
    try:
# Vérifictaion que le colonne à tester est dans le csv
        if colonne not in df.columns:
            raise DonneeInvalide(f"La colonne {colonne} est introuvables")
    except DonneeInvalide as e :
        print(e) 
# Variables aberrantes du prix
try:
    nb_prix_invalides = (df["price"] <= 0).sum()
    if nb_prix_invalides > 0:
        raise DonneeInvalide(f"Il y a {nb_prix_invalides} prix invalides")
    else:
        print ("Tous les prix sont valides")
except DonneeInvalide as e :
        print(e) 
# Variables aberrantes du nombre de bedrooms, de bathrooms, sqft_living, sqft_lot, floors, sqft_above, sqft_basement
try:        
    for colonne in [
        "bedrooms", 
        "bathrooms",
        "sqft_living", 
        "sqft_lot",
        "floors",
        "sqft_above",
        "sqft_basement",
    ]:
            invalide = (df[colonne] < 0).sum()
            if invalide > 0:
                raise DonneeInvalide (f"{colonne} : {invalide} valeur(s) abberante(s).")
    else : 
        print ("Aucune valeurs aberantes trouvées.")   
except DonneeInvalide as e :
    print(e)
# Années de rénovation >= années de construction
try:
    invalide = ((df["yr_renovated"] > 0 ) & (df["yr_renovated"] <df["yr_built"])).sum()         # & = and en pandas
    if invalide > 0:
        raise DonneeInvalide (f"yr_renovated : {invalide} année(s) de rénovation avant la construction")
    else:
        print("yr_renovated : toute les valeurs sont valides")
except DonneeInvalide as e:
    print (e)

# Valeurs préautorisée pour : les conditions (1 à 5), view (0 à 4) et waterfront(0 ou 1)
valeurs_permises = {
    "condition" : [1, 2, 3, 4, 5],
    "view" : [0, 1, 2, 3, 4],
    "waterfront" : [0, 1]
} 
for colonne, permises in valeurs_permises.items():
    try:
        invalide = (~ df[colonne].isin(permises)).sum()                     # ~ = opérateur de négation en pandas : il inverse chaque True en False et inversement.
        if invalide > 0:
            raise DonneeInvalide(f"{colonne} : {invalide} valeur(s) hors de {permises}")
        else :
            print(f"{colonne} : toutes les valeurs sont valides")
    except DonneeInvalide as e:
        print (e)
